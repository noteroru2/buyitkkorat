# Optional public configuration — never commit real secrets that are private.
# Leave blank to disable features safely (site still builds).

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification token
PUBLIC_GSC_VERIFICATION=

# Official Facebook Page URL (https://facebook.com/...)
PUBLIC_FACEBOOK_URL=

# Verified Google Maps URL for Ubon storefront
PUBLIC_GOOGLE_MAPS_URL=

# Google Business Profile URL (if any)
PUBLIC_GBP_URL=

# Verified storefront street address (Ubon only)
PUBLIC_STORE_STREET_ADDRESS=

# Postal code for Ubon storefront
PUBLIC_STORE_POSTAL_CODE=

# Opening hours text (e.g. Mo-Sa 09:00-18:00)
PUBLIC_STORE_HOURS=
