# Optional overrides — verified storefront / Maps / Facebook defaults live in src/data/site.ts.
# Leave GA4, GSC, and Lead endpoint blank until verified. Do not commit a filled .env with private tokens.

# Google Analytics 4 Measurement ID (must match G-XXXXXXXX; leave blank until verified)
PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification token (leave blank until verified)
PUBLIC_GSC_VERIFICATION=

# Future lead capture HTTPS endpoint (leave blank — no Production form until backend is verified)
PUBLIC_LEAD_ENDPOINT=

# Overrides (optional — defaults already set in site.ts)
PUBLIC_FACEBOOK_URL=
PUBLIC_GOOGLE_MAPS_URL=
PUBLIC_GBP_URL=
PUBLIC_STORE_STREET_ADDRESS=
PUBLIC_STORE_SUBDISTRICT=
PUBLIC_STORE_DISTRICT=
PUBLIC_STORE_PROVINCE=
PUBLIC_STORE_POSTAL_CODE=
PUBLIC_STORE_COUNTRY=
PUBLIC_STORE_HOURS_TEXT=
PUBLIC_STORE_OPENING_HOURS=
