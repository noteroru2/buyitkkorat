---
interface Props {
  type?:
    | "phone"
    | "notebook"
    | "desktop"
    | "gpu"
    | "camera"
    | "console"
    | "speaker"
    | "parcel"
    | "line"
    | "staff"
    | "devices";
  title?: string;
}

const { type = "devices", title = "ภาพประกอบอุปกรณ์ไอที" } = Astro.props;
---

<figure class="illus" aria-label={title}>
  {
    type === "phone" && (
      <svg viewBox="0 0 320 260" width="320" height="260" role="img">
        <title>{title}</title>
        <rect x="110" y="20" width="100" height="200" rx="18" fill="#fff" stroke="#ff8a3d" stroke-width="4" />
        <rect x="122" y="40" width="76" height="140" rx="8" fill="#e7f2ff" />
        <circle cx="160" cy="200" r="10" fill="#dff7ea" stroke="#24324a" stroke-width="2" />
        <circle cx="250" cy="70" r="28" fill="#ff6b6b" opacity="0.25" />
      </svg>
    )
  }
  {
    type === "notebook" && (
      <svg viewBox="0 0 320 260" width="320" height="260" role="img">
        <title>{title}</title>
        <rect x="50" y="40" width="220" height="130" rx="12" fill="#fff" stroke="#24324a" stroke-width="3" />
        <rect x="68" y="56" width="184" height="98" rx="6" fill="#e7f2ff" />
        <path d="M30 180h260l-20 28H50z" fill="#ff8a3d" />
        <rect x="140" y="188" width="40" height="8" rx="4" fill="#fff8ef" />
      </svg>
    )
  }
  {
    type === "desktop" && (
      <svg viewBox="0 0 320 260" width="320" height="260" role="img">
        <title>{title}</title>
        <rect x="70" y="30" width="180" height="120" rx="10" fill="#fff" stroke="#24324a" stroke-width="3" />
        <rect x="86" y="46" width="148" height="88" fill="#dff7ea" />
        <rect x="145" y="150" width="30" height="24" fill="#ff8a3d" />
        <rect x="110" y="174" width="100" height="12" rx="6" fill="#24324a" />
      </svg>
    )
  }
  {
    type === "gpu" && (
      <svg viewBox="0 0 320 260" width="320" height="260" role="img">
        <title>{title}</title>
        <rect x="40" y="70" width="240" height="100" rx="16" fill="#fff" stroke="#ff6b6b" stroke-width="3" />
        <circle cx="110" cy="120" r="28" fill="#e7f2ff" stroke="#24324a" />
        <circle cx="180" cy="120" r="28" fill="#e7f2ff" stroke="#24324a" />
        <rect x="230" y="95" width="30" height="50" rx="4" fill="#ff8a3d" />
      </svg>
    )
  }
  {
    type === "camera" && (
      <svg viewBox="0 0 320 260" width="320" height="260" role="img">
        <title>{title}</title>
        <rect x="60" y="70" width="200" height="120" rx="18" fill="#fff" stroke="#24324a" stroke-width="3" />
        <circle cx="160" cy="130" r="42" fill="#e7f2ff" stroke="#ff8a3d" stroke-width="4" />
        <circle cx="160" cy="130" r="18" fill="#24324a" />
        <rect x="90" y="55" width="50" height="20" rx="6" fill="#ff6b6b" />
      </svg>
    )
  }
  {
    type === "console" && (
      <svg viewBox="0 0 320 260" width="320" height="260" role="img">
        <title>{title}</title>
        <rect x="40" y="90" width="240" height="90" rx="28" fill="#fff" stroke="#24324a" stroke-width="3" />
        <circle cx="100" cy="135" r="18" fill="#dff7ea" stroke="#24324a" />
        <circle cx="220" cy="120" r="8" fill="#ff6b6b" />
        <circle cx="240" cy="135" r="8" fill="#ff8a3d" />
        <circle cx="220" cy="150" r="8" fill="#e7f2ff" stroke="#24324a" />
      </svg>
    )
  }
  {
    type === "speaker" && (
      <svg viewBox="0 0 320 260" width="320" height="260" role="img">
        <title>{title}</title>
        <rect x="110" y="30" width="100" height="180" rx="20" fill="#fff" stroke="#24324a" stroke-width="3" />
        <circle cx="160" cy="100" r="28" fill="#e7f2ff" />
        <circle cx="160" cy="170" r="18" fill="#dff7ea" />
      </svg>
    )
  }
  {
    type === "parcel" && (
      <svg viewBox="0 0 320 260" width="320" height="260" role="img">
        <title>{title}</title>
        <path d="M60 100l100-40 100 40v90l-100 40-100-40z" fill="#fff8ef" stroke="#ff8a3d" stroke-width="3" />
        <path d="M160 60v170M60 100l100 40 100-40" fill="none" stroke="#24324a" stroke-width="2" />
      </svg>
    )
  }
  {
    type === "line" && (
      <svg viewBox="0 0 320 260" width="320" height="260" role="img">
        <title>{title}</title>
        <rect x="50" y="40" width="220" height="160" rx="24" fill="#06c755" />
        <rect x="78" y="70" width="120" height="28" rx="14" fill="#fff" />
        <rect x="120" y="118" width="120" height="28" rx="14" fill="#dff7ea" />
      </svg>
    )
  }
  {
    type === "staff" && (
      <svg viewBox="0 0 320 260" width="320" height="260" role="img">
        <title>{title}</title>
        <circle cx="160" cy="80" r="36" fill="#ffd7b8" stroke="#24324a" stroke-width="2" />
        <path d="M90 210c10-50 40-70 70-70s60 20 70 70" fill="#ff8a3d" />
        <rect x="200" y="110" width="70" height="50" rx="8" fill="#e7f2ff" stroke="#24324a" />
      </svg>
    )
  }
  {
    type === "devices" && (
      <svg viewBox="0 0 360 280" width="360" height="280" role="img">
        <title>{title}</title>
        <rect x="30" y="70" width="70" height="130" rx="14" fill="#fff" stroke="#ff8a3d" stroke-width="3" />
        <rect x="120" y="50" width="160" height="100" rx="12" fill="#fff" stroke="#24324a" stroke-width="3" />
        <rect x="130" y="62" width="140" height="70" fill="#e7f2ff" />
        <path d="M110 160h180l-16 22H126z" fill="#ff6b6b" />
        <rect x="250" y="150" width="90" height="70" rx="12" fill="#dff7ea" stroke="#24324a" stroke-width="3" />
      </svg>
    )
  }
</figure>

<style>
  .illus {
    margin: 0;
    filter: drop-shadow(0 12px 24px rgba(36, 50, 74, 0.08));
  }

  @media (prefers-reduced-motion: no-preference) {
    .illus {
      animation: floaty 5s ease-in-out infinite;
    }
  }

  @keyframes floaty {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
</style>
