---
import PrimaryLineCTA from "./PrimaryLineCTA.astro";
import { SITE } from "../data/site";

interface Props {
  h1: string;
  lead: string;
  illustration?: string;
  showPhone?: boolean;
}

const {
  h1,
  lead,
  illustration = "devices",
  showPhone = true,
} = Astro.props;
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <div class="hero__eyebrow"><span aria-hidden="true"></span>{SITE.tradeName} · {SITE.brand}</div>
      <h1>{h1}</h1>
      <p class="hero__lead">{lead}</p>

      <ul class="hero__proofs" aria-label="ข้อมูลสำคัญก่อนติดต่อ">
        <li><span aria-hidden="true">✓</span>เริ่มประเมินจากรูปได้</li>
        <li><span aria-hidden="true">✓</span>ไม่ต้องเดินทางก่อนทราบราคาเบื้องต้น</li>
        <li><span aria-hidden="true">✓</span>ราคาสุดท้ายยืนยันหลังตรวจจริง</li>
      </ul>

      <div class="cta-row hero__actions">
        <PrimaryLineCTA label="ส่งรูปประเมินทาง LINE" event="hero_line_click" />
        {
          showPhone && (
            <a class="btn btn--phone" href={`tel:${SITE.phoneTel}`} data-event="phone_click" data-cta="hero_phone">
              โทร {SITE.phoneDisplay}
            </a>
          )
        }
      </div>
      <p class="hero__line-hint">LINE OA <strong>{SITE.lineId}</strong> · ส่งรุ่น สเปก รูป และตำหนิที่เห็นได้</p>
    </div>

    <div class="hero__art">
      <div class="hero__visual-card">
        <div class="hero__visual-head">
          <div>
            <span>ประเมินเบื้องต้น</span>
            <strong>เริ่มได้ใน 3 ขั้นตอน</strong>
          </div>
          <span class="hero__line-badge">LINE {SITE.lineId}</span>
        </div>
        <div class="hero__illustration" aria-hidden="true"><slot name="illustration" /></div>
        <ol class="hero__steps">
          <li><span>1</span><small>ส่งรูป + รุ่น</small></li>
          <li><span>2</span><small>แจ้งสภาพ</small></li>
          <li><span>3</span><small>รับราคาเบื้องต้น</small></li>
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(2.25rem, 5vw, 4.6rem) 0 clamp(2.4rem, 5vw, 4.3rem);
    background:
      radial-gradient(circle at 85% 12%, rgba(249, 115, 22, .11), transparent 28rem),
      linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .hero::before {
    content: "";
    position: absolute;
    width: 26rem;
    height: 26rem;
    border-radius: 50%;
    left: -15rem;
    bottom: -20rem;
    background: rgba(255, 237, 213, .7);
    filter: blur(10px);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: 2.2rem;
    align-items: center;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    margin-bottom: .85rem;
    color: var(--color-primary-dark);
    font-size: .8rem;
    font-weight: 800;
    letter-spacing: .02em;
  }

  .hero__eyebrow span {
    width: .55rem;
    height: .55rem;
    border-radius: 999px;
    background: var(--color-primary);
    box-shadow: 0 0 0 5px rgba(249, 115, 22, .12);
  }

  .hero h1 {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(2rem, 5.2vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -.045em;
    color: var(--color-navy);
  }

  .hero__lead {
    margin: 1rem 0 0;
    max-width: 43rem;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.72;
  }

  .hero__proofs {
    list-style: none;
    margin: 1.15rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: .5rem .75rem;
  }

  .hero__proofs li {
    display: inline-flex;
    align-items: center;
    gap: .38rem;
    padding: .42rem .68rem;
    border-radius: 999px;
    background: white;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: .78rem;
    font-weight: 650;
    box-shadow: var(--shadow-xs);
  }

  .hero__proofs span {
    color: #15803d;
    font-weight: 900;
  }

  .hero__actions { margin-top: 1.35rem; }
  .hero__actions :global(.btn) { min-height: 50px; padding-inline: 1.25rem; }
  .hero__actions :global(.btn--line) { box-shadow: 0 10px 25px rgba(6,199,85,.2); }

  .hero__line-hint {
    margin: .75rem 0 0;
    color: var(--color-text-subtle);
    font-size: .78rem;
  }

  .hero__line-hint strong { color: var(--color-text); }
  .hero__art { display:grid; place-items:center; }

  .hero__visual-card {
    width: min(100%, 31rem);
    padding: 1rem;
    border-radius: 1.5rem;
    background: rgba(255,255,255,.9);
    border: 1px solid rgba(203, 213, 225, .86);
    box-shadow: 0 24px 65px rgba(15, 23, 42, .11);
  }

  .hero__visual-head {
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:.75rem;
    padding:.3rem .3rem .6rem;
  }

  .hero__visual-head > div { display:flex; flex-direction:column; line-height:1.25; }
  .hero__visual-head span { color:var(--color-text-subtle); font-size:.7rem; }
  .hero__visual-head strong { margin-top:.15rem; font-size:.95rem; color:var(--color-navy); }

  .hero__line-badge {
    padding:.38rem .6rem;
    border-radius:999px;
    background:#ecfdf3;
    border:1px solid #bbf7d0;
    color:#087a36 !important;
    font-weight:800;
    white-space:nowrap;
  }

  .hero__illustration {
    min-height: 12rem;
    display:grid;
    place-items:center;
    padding: .75rem 1.25rem;
    border-radius: 1.1rem;
    background:
      radial-gradient(circle at 70% 30%, rgba(59,130,246,.1), transparent 45%),
      linear-gradient(135deg, #fff7ed 0%, #f8fafc 48%, #eff6ff 100%);
  }

  .hero__illustration :global(svg) { max-height: 10.5rem; }

  .hero__steps {
    list-style:none;
    margin:.85rem 0 0;
    padding:0;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:.45rem;
  }

  .hero__steps li {
    display:flex;
    align-items:center;
    gap:.4rem;
    min-width:0;
    padding:.55rem;
    border-radius:.8rem;
    background:#f8fafc;
  }

  .hero__steps li > span {
    width:1.55rem;
    height:1.55rem;
    flex:0 0 1.55rem;
    border-radius:.5rem;
    display:grid;
    place-items:center;
    background:var(--color-primary-soft);
    color:var(--color-primary-dark);
    font-size:.7rem;
    font-weight:900;
  }

  .hero__steps small { font-size:.68rem; line-height:1.25; color:var(--color-text-muted); }

  @media (min-width: 900px) {
    .hero__grid { grid-template-columns:minmax(0,1.15fr) minmax(24rem,.85fr); gap:3.5rem; }
  }

  @media (max-width: 639px) {
    .hero__art { margin-top:.25rem; }
    .hero__visual-card { padding:.75rem; }
    .hero__steps { grid-template-columns:1fr; }
    .hero__steps li { padding:.45rem .55rem; }
    .hero__illustration { min-height:9rem; }
  }
</style>
