---
import { SITE } from "../data/site";
import { absoluteUrl, buildTitle, truncateDescription } from "../utils/seo";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  updatedDate?: Date | string;
}

const {
  title,
  description,
  canonical,
  ogImage = SITE.defaultOgImage,
  ogType = "website",
  noindex = false,
  updatedDate,
} = Astro.props;

const pageTitle = buildTitle(title);
const metaDescription = truncateDescription(description);
const pathFromUrl = Astro.url.pathname.replace(/\/$/, "");
const resolvedPath = canonical ?? (pathFromUrl === "" ? "/" : pathFromUrl);
const canonicalUrl = absoluteUrl(resolvedPath);
const ogImageUrl = absoluteUrl(ogImage);
const robots = noindex ? "noindex, nofollow" : "index, follow";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={metaDescription} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#ff8a3d" />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImageUrl} />
{updatedDate && (
  <meta property="article:modified_time" content={new Date(updatedDate).toISOString()} />
)}
{
  SITE.analytics.gscVerification && (
    <meta name="google-site-verification" content={SITE.analytics.gscVerification} />
  )
}
<meta name="generator" content={Astro.generator} />
