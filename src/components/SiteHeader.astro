---
import { CONTACT_CHANNELS, MAIN_NAV, SITE, STORE_LOCATION } from "../data/site";
import PrimaryLineCTA from "./PrimaryLineCTA.astro";
---

<header class="header">
  <div class="header__trustbar">
    <div class="container header__trustbar-inner">
      <p><strong>{STORE_LOCATION.tradeName}</strong> · ดำเนินงานโดย {SITE.legalName}</p>
      <p class="header__trustbar-service">หน้าร้านจริงอุบลราชธานี · ให้บริการลูกค้าโคราชตามเงื่อนไข</p>
    </div>
  </div>

  <div class="container header__bar">
    <a class="header__brand" href="/" aria-label={`${SITE.name} หน้าแรก`}>
      <span class="header__mark" aria-hidden="true">W</span>
      <span class="header__brand-text">
        <strong>{SITE.brand}</strong>
        <small>รับซื้อไอทีโคราช</small>
      </span>
    </a>

    <nav class="header__nav" aria-label="เมนูหลัก">
      <ul class="header__list">
        {
          MAIN_NAV.map((item) => (
            <li class:list={["header__item", item.children?.length && "header__item--has-menu"]}>
              <a class="header__nav-link" href={item.href}>
                {item.label}
                {item.children?.length && <span class="header__chevron" aria-hidden="true">⌄</span>}
              </a>
              {item.children?.length && (
                <div class="header__dropdown">
                  <div class="header__dropdown-title">{item.label}</div>
                  {item.children.map((child) => (
                    <a href={child.href}>{child.label}<span aria-hidden="true">→</span></a>
                  ))}
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={`tel:${SITE.phoneTel}`} data-event="phone_click" data-cta="header_phone">
        <span class="header__phone-label">โทรสอบถาม</span>
        <strong>{SITE.phoneDisplay}</strong>
      </a>
      <PrimaryLineCTA label={`LINE ${SITE.lineId}`} event="line_click" class="header__line" />
      <button
        class="header__menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-mobile-menu-toggle
      >
        <span class="visually-hidden">เปิดเมนู</span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, .96);
    border-bottom: 1px solid rgba(203, 213, 225, .72);
    box-shadow: 0 8px 24px rgba(15, 23, 42, .045);
    backdrop-filter: blur(14px);
  }

  .header__trustbar {
    display: none;
    background: var(--color-navy);
    color: #dbe3ef;
    font-size: .72rem;
  }

  .header__trustbar-inner {
    min-height: 1.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header__trustbar p { margin: 0; }
  .header__trustbar strong { color: white; }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.55rem;
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .header__mark {
    width: 2.45rem;
    height: 2.45rem;
    border-radius: .8rem;
    background: linear-gradient(145deg, var(--color-primary) 0%, #fb5f24 100%);
    color: white;
    display: grid;
    place-items: center;
    font-weight: 900;
    box-shadow: 0 8px 20px rgba(249, 115, 22, .2);
  }

  .header__brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .header__brand-text strong {
    font-size: 1rem;
    letter-spacing: .02em;
  }

  .header__brand-text small {
    margin-top: .22rem;
    font-size: .7rem;
    color: var(--color-text-muted);
  }

  .header__nav { display: none; }
  .header__list { display:flex; align-items:center; gap:.15rem; list-style:none; margin:0; padding:0; }
  .header__item { position: relative; }

  .header__nav-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding: 0 .68rem;
    border-radius: .7rem;
    color: var(--color-text);
    text-decoration: none;
    font-size: .84rem;
    font-weight: 700;
  }

  .header__nav-link:hover,
  .header__item:focus-within > .header__nav-link {
    background: #f1f5f9;
    color: var(--color-primary-dark);
  }

  .header__chevron { font-size: .85rem; transform: translateY(-1px); }

  .header__dropdown {
    position: absolute;
    top: calc(100% + .5rem);
    left: 0;
    width: 18rem;
    padding: .65rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 1rem;
    background: white;
    box-shadow: var(--shadow-xl);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity .14s ease, transform .14s ease, visibility .14s ease;
  }

  .header__item:hover .header__dropdown,
  .header__item:focus-within .header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header__dropdown-title {
    padding: .35rem .65rem .45rem;
    color: var(--color-text-subtle);
    font-size: .68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .header__dropdown a {
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .8rem;
    padding: .45rem .65rem;
    border-radius: .65rem;
    color: var(--color-text);
    text-decoration: none;
    font-size: .83rem;
    font-weight: 600;
  }

  .header__dropdown a:hover { background:#fff7ed; color:var(--color-primary-dark); }
  .header__dropdown a span { color:var(--color-primary); }

  .header__actions { display:flex; align-items:center; gap:.5rem; margin-left:auto; }

  .header__phone {
    display: none;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-text);
    line-height: 1.15;
    padding: .35rem .2rem;
  }

  .header__phone-label { font-size:.66rem; color:var(--color-text-subtle); }
  .header__phone strong { font-size:.78rem; }

  :global(.header__line) {
    display: inline-flex;
    min-height: 42px;
    padding-inline: .9rem;
    box-shadow: 0 7px 18px rgba(6, 199, 85, .18);
  }

  .header__menu-btn {
    width: 42px;
    height: 42px;
    border: 1px solid var(--color-border-strong);
    border-radius: .75rem;
    background: white;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    cursor: pointer;
  }

  .header__menu-btn span:not(.visually-hidden) {
    width: 17px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
  }

  @media (max-width: 420px) {
    .header__brand-text small { display:none; }
    .header__brand { gap:.45rem; }
    :global(.header__line) { padding-inline:.72rem; font-size:.78rem; }
    :global(.header__line svg) { width:17px; height:17px; }
  }

  @media (min-width: 1024px) {
    .header__trustbar { display:block; }
    .header__nav { display:block; }
    .header__phone { display:flex; }
    .header__menu-btn { display:none; }
  }

  @media (min-width: 1200px) {
    .header__nav-link { padding-inline:.82rem; font-size:.87rem; }
    .header__phone strong { font-size:.82rem; }
  }
</style>
