---
import MapsCTA from "./MapsCTA.astro";
import FacebookCTA from "./FacebookCTA.astro";
import PrimaryLineCTA from "./PrimaryLineCTA.astro";
import { CONTACT_CHANNELS, SERVICE_AREA, SITE, STORE_LOCATION, formatStoreFullAddress } from "../data/site";

interface Props { compact?: boolean; showServiceArea?: boolean; ctaPrefix?: string; }
const { compact=false, showServiceArea=true, ctaPrefix="identity" } = Astro.props;
const fullAddress=formatStoreFullAddress();
---

<section class:list={["store-identity", compact && "store-identity--compact"]} aria-labelledby="store-identity-title" data-component="StoreIdentityCard">
  <div class="container store-identity__shell">
    <div class="store-identity__heading">
      <span class="section__eyebrow">ความน่าเชื่อถือ</span>
      <h2 id="store-identity-title">ตรวจสอบตัวตนร้านก่อนขายได้</h2>
      <p><strong>{STORE_LOCATION.tradeName}</strong> ภายใต้แบรนด์ {SITE.brand} · ดำเนินงานโดย {SITE.legalName}</p>
    </div>

    <dl class="store-identity__facts">
      <div><dt>หน้าร้านจริง</dt><dd>จังหวัด{STORE_LOCATION.province}</dd></div>
      <div><dt>เวลาทำการ</dt><dd>{STORE_LOCATION.openingHoursText}</dd></div>
      <div class="store-identity__facts--wide"><dt>ที่อยู่</dt><dd>{fullAddress}</dd></div>
      {showServiceArea && <div class="store-identity__facts--wide"><dt>บริการลูกค้าโคราช</dt><dd>{SERVICE_AREA.label} — ไม่ใช่สาขาหรือหน้าร้านประจำ</dd></div>}
    </dl>

    <div class="store-identity__actions">
      <PrimaryLineCTA label={`LINE ${SITE.lineId}`} event="line_click" />
      <a class="btn btn--phone" href={`tel:${SITE.phoneTel}`} data-event="phone_click" data-cta={`${ctaPrefix}_phone`}>โทร {SITE.phoneDisplay}</a>
      {CONTACT_CHANNELS.mapsUrl && <MapsCTA cta={`${ctaPrefix}_maps`} />}
      {CONTACT_CHANNELS.facebookUrl && <FacebookCTA label="Facebook ร้าน" />}
      <a class="btn btn--ghost" href="/เกี่ยวกับเรา">ข้อมูลร้าน</a>
    </div>
  </div>
</section>

<style>
  .store-identity { padding:clamp(2.5rem,5vw,4.2rem) 0; }
  .store-identity--compact { padding:2.25rem 0; }
  .store-identity__shell {
    padding:clamp(1.35rem,3vw,2.2rem);
    border:1px solid var(--color-border-strong);
    border-radius:var(--radius-xl);
    background:linear-gradient(135deg,#ffffff 0%,#f7fafc 100%);
    box-shadow:var(--shadow-sm);
  }
  .store-identity__heading h2 { margin:.2rem 0 .4rem; font-size:var(--font-size-2xl); line-height:1.3; }
  .store-identity__heading p { max-width:46rem; margin:.4rem 0 0; color:var(--color-text-muted); }
  .store-identity__facts { display:grid; gap:.7rem; margin:1.25rem 0; padding:0; }
  .store-identity__facts div { margin:0; padding:.9rem 1rem; background:white; border:1px solid var(--color-border); border-radius:.85rem; }
  .store-identity__facts dt { margin:0 0 .15rem; color:var(--color-text-subtle); font-size:.72rem; font-weight:750; }
  .store-identity__facts dd { margin:0; color:var(--color-navy); font-size:.88rem; font-weight:700; line-height:1.5; }
  .store-identity__actions { display:flex; flex-wrap:wrap; gap:.55rem; }
  @media(min-width:720px){
    .store-identity__facts { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .store-identity__facts--wide { grid-column:span 2; }
  }
  @media(min-width:1024px){
    .store-identity__facts { grid-template-columns:repeat(4,minmax(0,1fr)); }
    .store-identity__facts--wide { grid-column:span 2; }
  }
</style>
