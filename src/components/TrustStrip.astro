---
const items = [
  { title: "ประเมินผ่าน LINE", text: "ส่งรุ่น รูป และสภาพเพื่อรับการประเมินเบื้องต้น" },
  {
    title: "หน้าร้านอุบล · บริการโคราช",
    text: "หน้าร้านจริงที่อุบลราชธานี ให้บริการลูกค้าในนครราชสีมาแบบนัดรับหรือจัดส่ง ไม่ใช่สาขาโคราช",
  },
  { title: "โปร่งใสราคา", text: "ราคาสุดท้ายยืนยันหลังตรวจสอบสินค้าจริง" },
  { title: "บุคคลและองค์กร", text: "รองรับรายชิ้น หลายชิ้น และยกล็อตตามเงื่อนไข" },
];
---

<section class="trust section--tight" aria-label="จุดเด่นบริการ">
  <div class="container trust__grid">
    {
      items.map((item) => (
        <article class="trust__item">
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .trust__grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .trust__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trust__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .trust__item {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }

  .trust__item h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-base);
  }

  .trust__item p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
</style>
