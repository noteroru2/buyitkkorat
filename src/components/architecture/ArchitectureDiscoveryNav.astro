---
import navigation from '../../config/navigation-architecture.json';

interface Props {
  title?: string;
}

const { title = 'ค้นหาบริการและข้อมูลที่เกี่ยวข้อง' } = Astro.props;
const urls = [
  ...navigation.discovery.homepage.primaryHubs,
  ...navigation.discovery.homepage.appleDirectOwners,
];

const labels = new Map([
  ['/รับซื้อสินค้าไอที', 'รับซื้อสินค้าไอที'],
  ['/รับซื้อโน๊ตบุ๊ค-โคราช', 'รับซื้อโน๊ตบุ๊ค'],
  ['/รับซื้อคอมพิวเตอร์-โคราช', 'รับซื้อคอมพิวเตอร์'],
  ['/รับซื้อโทรศัพท์มือถือ-โคราช', 'รับซื้อโทรศัพท์มือถือ'],
  ['/รับซื้อสินค้าไอทียกล็อต', 'รับซื้อยกล็อต / บริษัท'],
  ['/พื้นที่', 'พื้นที่ให้บริการ'],
  ['/วิธีขายสินค้า', 'วิธีขายสินค้า'],
  ['/บทความ', 'บทความและคู่มือ'],
  ['/รับซื้อ-iphone-โคราช', 'รับซื้อ iPhone'],
  ['/รับซื้อ-macbook-โคราช', 'รับซื้อ MacBook'],
]);
---

<nav class="architecture-discovery" aria-label={title}>
  <h2>{title}</h2>
  <ul>
    {urls.map((url) => (
      <li><a href={url}>{labels.get(url) ?? url}</a></li>
    ))}
  </ul>
</nav>

<style>
  .architecture-discovery {
    width: min(100% - 2rem, 72rem);
    margin: 2rem auto;
  }
  .architecture-discovery ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: .65rem;
  }
  .architecture-discovery a {
    display: block;
    padding: .8rem .9rem;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: .7rem;
    color: inherit;
    text-decoration: none;
    font-weight: 650;
  }
</style>
