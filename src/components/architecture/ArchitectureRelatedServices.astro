---
import {
  getRuntimeDiscoveryHeading,
  getRuntimeDiscoveryLinks,
  getRuntimeRelatedHeading,
  getRuntimeRelatedLinks,
} from '../../config/runtime-architecture';

interface Props {
  pathname?: string;
  discoveryLimit?: number;
  relatedLimit?: number;
}

const {
  pathname = Astro.url.pathname,
  discoveryLimit = 16,
  relatedLimit = 6,
} = Astro.props;
const discovery = getRuntimeDiscoveryLinks(pathname, discoveryLimit);
const related = getRuntimeRelatedLinks(pathname, relatedLimit);
const discoveryHeading = getRuntimeDiscoveryHeading(pathname);
const relatedHeading = getRuntimeRelatedHeading(pathname);
---

{discovery.length > 0 && (
  <aside class="architecture-links architecture-links--discovery" aria-labelledby="architecture-discovery-heading">
    <div class="architecture-links__inner">
      <h2 id="architecture-discovery-heading">{discoveryHeading}</h2>
      <ul>
        {discovery.map((link) => (
          <li><a href={link.url}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </aside>
)}

{related.length > 0 && (
  <aside class="architecture-links architecture-links--related" aria-labelledby="architecture-related-heading">
    <div class="architecture-links__inner">
      <h2 id="architecture-related-heading">{relatedHeading}</h2>
      <ul>
        {related.map((link) => (
          <li><a href={link.url}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </aside>
)}

<style>
  .architecture-links {
    width: min(100% - 2rem, 72rem);
    margin: 2rem auto 0;
  }
  .architecture-links + .architecture-links {
    margin-top: 1rem;
  }
  .architecture-links__inner {
    padding: 1rem 1.125rem;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: .875rem;
  }
  .architecture-links h2 {
    margin: 0 0 .75rem;
    font-size: 1.05rem;
    line-height: 1.4;
  }
  .architecture-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem .9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .architecture-links a {
    color: inherit;
    text-underline-offset: .2em;
  }
</style>
