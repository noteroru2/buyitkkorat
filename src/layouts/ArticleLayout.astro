---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RelatedServices from "../components/RelatedServices.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
import ContentContactAside from "../components/ContentContactAside.astro";
import PageCoverSection from "../components/PageCoverSection.astro";
import ImageCTASection from "../components/ImageCTASection.astro";
import { SITE, STORE_LOCATION } from "../data/site";
import type { PageVisualAsset } from "../data/pageVisuals";
import type { BreadcrumbItem } from "../utils/seo";

interface Related { title:string; href:string; excerpt?:string; }
interface Props {
  title:string; description:string; h1:string; breadcrumbs:BreadcrumbItem[];
  canonical?:string; ogImage?:string; updatedDate?:Date|string; publishedDate?:Date|string;
  schema?:Record<string,unknown>|Record<string,unknown>[];
  relatedServices?:Related[]; relatedArticles?:Related[];
  coverVisual?: PageVisualAsset; ctaVisual?: PageVisualAsset;
}
const props=Astro.props;
const publishedLabel=props.publishedDate?new Date(props.publishedDate).toLocaleDateString("th-TH"):null;
const updatedLabel=props.updatedDate?new Date(props.updatedDate).toLocaleDateString("th-TH"):null;
---

<BaseLayout title={props.title} description={props.description} canonical={props.canonical} ogImage={props.ogImage} ogType="article" updatedDate={props.updatedDate} schema={props.schema}>
  <section class="page-intro article-intro">
    <div class="container page-intro__inner">
      <Breadcrumbs items={props.breadcrumbs} />
      <p class="badge">คู่มือก่อนขายสินค้าไอที</p>
      <h1>{props.h1}</h1>
      <p class="page-intro__meta">
        โดย {STORE_LOCATION.tradeName} ({SITE.brand})
        {publishedLabel && <> · เผยแพร่ {publishedLabel}</>}
        {updatedLabel && <> · อัปเดต {updatedLabel}</>}
      </p>
      <p class="page-intro__lead article-intro__disclaimer">เนื้อหาอธิบายขั้นตอนและปัจจัยสำหรับสินค้ามือสอง ไม่ใช่การรับประกันราคาสุดท้าย</p>
    </div>
  </section>

  {props.coverVisual && (
    <PageCoverSection
      image={props.coverVisual.image}
      alt={props.coverVisual.alt}
      caption={props.coverVisual.caption}
      slotId={props.coverVisual.slotId}
      eyebrow="ภาพประกอบเนื้อหา"
      title="สรุปภาพรวมของหัวข้อในหน้านี้"
      lead="เลือกใช้ภาพจริงสไตล์เดียวกับหมวดสินค้า เพื่อให้บทความดูน่าอ่านและเข้าใจบริบทของอุปกรณ์ที่กำลังพูดถึงได้เร็วขึ้น"
    />
  )}

  <article class="section content-section">
    <div class="container content-layout">
      <div class="prose main-content content-card"><slot /></div>
      <ContentContactAside title="มีรุ่นที่ต้องการขายอยู่แล้ว?" note="อ่านคู่มือได้เต็มที่ หรือส่งรุ่นและรูปผ่าน LINE เพื่อประเมินสินค้าจริงของคุณได้เลย" />
    </div>
  </article>

  <RelatedServices title="หน้าบริการที่เกี่ยวข้อง" items={props.relatedServices ?? []} />
  <RelatedArticles title="อ่านต่อ" items={props.relatedArticles ?? []} />

  {props.ctaVisual && (
    <ImageCTASection
      image={props.ctaVisual.image}
      alt={props.ctaVisual.alt}
      slotId={props.ctaVisual.slotId}
      title="อ่านจบแล้ว ส่งรูปสินค้าให้ประเมินต่อได้ทันที"
      description="ถ้าคุณมีสินค้าอยู่แล้ว สามารถส่งรุ่น สเปก รูปสภาพ และอุปกรณ์ผ่าน LINE เพื่อรับการประเมินเบื้องต้นตามข้อมูลจริงของเครื่องได้เลย"
      note="บทความนี้เป็นข้อมูลประกอบการตัดสินใจ ส่วนราคาสุดท้ายขึ้นกับการตรวจสินค้าจริง"
      phoneCta="article_phone"
    />
  )}
</BaseLayout>

<style>
  .article-intro__disclaimer { font-size:.86rem; max-width:42rem; }
</style>
