---
import BaseLayout from "./BaseLayout.astro";
import { getImage } from 'astro:assets';
import ProductPhotoGallery from '../components/ProductPhotoGallery.astro';
import { photoGroupsForPath } from '../data/productPhotos';
import Breadcrumbs from "../components/Breadcrumbs.astro";
import HeroSection from "../components/HeroSection.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedServices from "../components/RelatedServices.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
import SafetyNotice from "../components/SafetyNotice.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import ContentContactAside from "../components/ContentContactAside.astro";
import ImageCTASection from "../components/ImageCTASection.astro";
import type { ImageMetadata } from "astro";
import type { PageVisualAsset } from "../data/pageVisuals";
import type { BreadcrumbItem } from "../utils/seo";

interface Faq { question: string; answer: string; }
interface Related { title: string; href: string; excerpt?: string; }

interface Props {
  title: string;
  description: string;
  h1: string;
  lead: string;
  breadcrumbs: BreadcrumbItem[];
  canonical?: string;
  ogImage?: string;
  updatedDate?: Date | string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  illustration?: "phone" | "notebook" | "desktop" | "gpu" | "camera" | "console" | "speaker" | "parcel" | "line" | "staff" | "devices";
  faqs?: Faq[];
  relatedServices?: Related[];
  relatedArticles?: Related[];
  pilotImage?: {
    src: ImageMetadata;
    alt: string;
    caption: string;
    slotId: string;
  };
  coverVisual: PageVisualAsset;
  ctaVisual?: PageVisualAsset;
}

const {
  title, description, h1, lead, breadcrumbs, canonical, ogImage, updatedDate, schema,
  faqs = [], relatedServices = [], relatedArticles = [], pilotImage,
  coverVisual, ctaVisual,
} = Astro.props;
const photoGroups=photoGroupsForPath(canonical ?? Astro.url.pathname);
const socialImage=await getImage({src:coverVisual.image,width:1200,height:630,fit:'cover',format:'webp'});
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={!ogImage || ogImage==='/og/default.png'?socialImage.src:ogImage} updatedDate={updatedDate} schema={schema}>
  <div class="container service-breadcrumbs"><Breadcrumbs items={breadcrumbs} /></div>

  <HeroSection h1={h1} lead={lead} visual={coverVisual} />


  {pilotImage && (
    <section class="section pilot-image-section" aria-label="ภาพประกอบขั้นตอนบริการ">
      <div class="container pilot-image-container">
        <ResponsiveImage
          src={pilotImage.src}
          alt={pilotImage.alt}
          caption={pilotImage.caption}
          width={1200}
          height={800}
          widths={[480, 768, 960, 1200]}
          sizes="(max-width: 767px) calc(100vw - 32px), 760px"
          loading="lazy"
          fetchpriority="low"
          slotId={pilotImage.slotId}
        />
      </div>
    </section>
  )}

  <article class="section content-section">
    <div class="container content-layout">
      <div class="prose main-content content-card"><slot /></div>
      <ContentContactAside />
    </div>
  </article>

  <SafetyNotice />
  <ProductPhotoGallery groups={photoGroups} />
  <FAQSection items={faqs} />
  <RelatedServices items={relatedServices} />
  <RelatedArticles items={relatedArticles} />

  {ctaVisual && (
    <ImageCTASection
      image={ctaVisual.image}
      alt={ctaVisual.alt}
      slotId={ctaVisual.slotId}
      title="พร้อมขายแล้ว? ส่งรูปทาง LINE ก่อนนัดรับ"
      description="ส่งรุ่น สเปก รูปสภาพ และตำหนิผ่าน LINE เพื่อให้ทีมงานตรวจข้อมูลเบื้องต้นได้เร็วขึ้น ก่อนคุยเรื่องนัดรับหรือการจัดส่ง"
      note="ราคาสุดท้ายยืนยันหลังตรวจสินค้าจริง สภาพ อุปกรณ์ และการใช้งานอีกครั้ง"
      phoneCta="service_final_phone"
    />
  )}
</BaseLayout>

<style>
  .service-breadcrumbs { padding-top:1rem; }
  .pilot-image-section { padding-block:2rem 0; }
  .pilot-image-container { max-width:52rem; }
</style>
