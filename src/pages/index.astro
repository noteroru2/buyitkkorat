---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import CuteDeviceIllustration from "../components/CuteDeviceIllustration.astro";
import TrustStrip from "../components/TrustStrip.astro";
import StoreIdentityCard from "../components/StoreIdentityCard.astro";
import ServiceAreaNotice from "../components/ServiceAreaNotice.astro";
import ValuationChecklist from "../components/ValuationChecklist.astro";
import EvidenceGallery from "../components/EvidenceGallery.astro";
import ServiceCategoryGrid from "../components/ServiceCategoryGrid.astro";
import WhatToPrepare from "../components/WhatToPrepare.astro";
import SellingProcess from "../components/SellingProcess.astro";
import ProductTypeGrid from "../components/ProductTypeGrid.astro";
import BusinessBulkSection from "../components/BusinessBulkSection.astro";
import ValuationFactors from "../components/ValuationFactors.astro";
import ServiceAreaGrid from "../components/ServiceAreaGrid.astro";
import SafetyNotice from "../components/SafetyNotice.astro";
import PrivacyNotice from "../components/PrivacyNotice.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
import FAQSection from "../components/FAQSection.astro";
import PageCoverSection from "../components/PageCoverSection.astro";
import ImageCTASection from "../components/ImageCTASection.astro";
import { HOME_PAGE_VISUALS } from "../data/pageVisuals";
import { SITE } from "../data/site";
import { absoluteUrl } from "../utils/seo";
import { buildGraph, faqSchema, webpageSchema } from "../utils/schema";

const articles = (await getCollection("articles"))
  .filter((a) => a.data.featured || a.data.indexable)
  .slice(0, 6)
  .map((a) => ({
    title: a.data.h1,
    href: `/บทความ/${a.data.slug}`,
    excerpt: a.data.excerpt,
  }));

const areas = (await getCollection("areas")).slice(0, 6).map((a) => ({
  title: a.data.areaName,
  description: a.data.excerpt,
  href: `/พื้นที่/${a.data.slug}`,
}));

const faqs = [
  {
    question: "รับซื้อสินค้าไอทีอะไรบ้างในโคราช",
    answer:
      "สอบถามได้ทั้งโทรศัพท์ แท็บเล็ต โน๊ตบุ๊ค คอมพิวเตอร์ การ์ดจอ กล้อง เครื่องเกม และอุปกรณ์สำนักงาน ส่งรุ่นและสภาพผ่าน LINE เพื่อยืนยันก่อน",
  },
  {
    question: "มีหน้าร้านในโคราชหรือไม่",
    answer:
      "ไม่มีหน้าร้านหรือสาขาประจำในจังหวัดนครราชสีมา หน้าร้านจริงอยู่จังหวัดอุบลราชธานี ลูกค้าในโคราชใช้บริการประเมิน นัดรับ หรือจัดส่งตามเงื่อนไข",
  },
  {
    question: "ราคาประเมินจากรูปยืนยันได้เลยหรือไม่",
    answer: SITE.priceDisclaimer,
  },
  {
    question: "ต้องส่งข้อมูลอะไรเพื่อประเมิน",
    answer:
      "ยี่ห้อ รุ่น สเปก สภาพ ตำหนิ อุปกรณ์ ประกัน จังหวัด และรูปสินค้า ดูรายการในส่วนเตรียมข้อมูลก่อนส่งประเมิน",
  },
  {
    question: "นัดรับถึงที่ใช้เวลานานแค่ไหน",
    answer:
      "ขึ้นกับคิว ระยะทาง และจำนวนสินค้า กรุณาสอบถามช่วงเวลาผ่าน LINE @buyhub",
  },
  {
    question: "สินค้าติด iCloud หรือบัญชี Google รับไหม",
    answer:
      "ไม่รับหากเจ้าของปลดบัญชีไม่ได้หรือยืนยันกรรมสิทธิ์ไม่ได้",
  },
];

const schema = buildGraph([
  webpageSchema({
    url: absoluteUrl("/"),
    name: "รับซื้อสินค้าไอทีโคราช ประเมินเบื้องต้นผ่าน LINE",
    description:
      "ร้านอำพล เทรดดิ้ง (WINNER IT) รับซื้อสินค้าไอทีมือสอง ประเมินผ่าน LINE @buyhub หน้าร้านอุบลราชธานี ให้บริการลูกค้าในนครราชสีมา",
    dateModified: "2026-08-05",
  }),
  faqSchema(faqs, absoluteUrl("/")),
]);
---

<BaseLayout
  title="รับซื้อสินค้าไอทีโคราช ประเมินเบื้องต้นผ่าน LINE | WINNER IT"
  description="ร้านอำพล เทรดดิ้ง รับซื้อสินค้าไอทีมือสอง ประเมินผ่าน LINE @buyhub หน้าร้านอุบลราชธานี ให้บริการลูกค้าในนครราชสีมา นัดรับตามเงื่อนไข"
  canonical="/"
  schema={schema}
  updatedDate={new Date("2026-08-05")}
>
  <HeroSection
    h1="รับซื้อสินค้าไอทีโคราช ประเมินเบื้องต้นผ่าน LINE"
    lead="ร้านอำพล เทรดดิ้ง (WINNER IT) รับซื้อโทรศัพท์ โน๊ตบุ๊ค คอมพิวเตอร์ และอุปกรณ์ไอที ส่งรูปประเมินผ่าน LINE @buyhub หน้าร้านจริงอยู่จังหวัดอุบลราชธานี ให้บริการลูกค้าในนครราชสีมาแบบนัดรับหรือจัดส่งตามเงื่อนไข"
  >
    <CuteDeviceIllustration slot="illustration" type="devices" title="อุปกรณ์ไอทีมือสอง" />
  </HeroSection>

  <PageCoverSection
    image={HOME_PAGE_VISUALS.cover.image}
    alt={HOME_PAGE_VISUALS.cover.alt}
    caption={HOME_PAGE_VISUALS.cover.caption}
    slotId={HOME_PAGE_VISUALS.cover.slotId}
    eyebrow="ภาพหน้าปกเว็บไซต์"
    title="หมวดสินค้าที่รับประเมินแบบเห็นภาพชัดขึ้น"
    lead="ใช้ภาพจริงสไตล์เดียวกันทั้งเว็บเพื่อให้หน้าแรกดูน่าเชื่อถือ เข้าใจง่าย และช่วยให้ลูกค้าเห็นประเภทอุปกรณ์ที่สามารถส่งมาประเมินได้ตั้งแต่ต้น"
  />

  <TrustStrip />
  <StoreIdentityCard ctaPrefix="home_identity" />
  <ServiceAreaNotice />

  <section class="section" aria-label="เตรียมส่งประเมินราคา">
    <div class="container">
      <ValuationChecklist showPrivacy={false} id="home-valuation" />
      <PrivacyNotice />
    </div>
  </section>

  <EvidenceGallery />

  <ServiceCategoryGrid
    items={[
      {
        title: "รับซื้อสินค้าไอที",
        description: "ภาพรวมบริการรับซื้อและหมวดสินค้าหลัก",
        href: "/รับซื้อสินค้าไอที",
      },
      {
        title: "รับซื้อถึงที่โคราช",
        description: "นัดรับตามพื้นที่และคิวในจังหวัดนครราชสีมา",
        href: "/บริการรับซื้อถึงที่โคราช",
      },
      {
        title: "ส่งสินค้ามาประเมิน",
        description: "ทางเลือกเมื่อยังไม่สะดวกนัดรับ",
        href: "/ส่งสินค้าไอทีมาประเมิน",
      },
      {
        title: "รับซื้อยกล็อต",
        description: "หลายชิ้น สำนักงาน หรือองค์กร",
        href: "/รับซื้อสินค้าไอทียกล็อต",
      },
      {
        title: "iPhone",
        description: "ประเมินรุ่น ความจุ แบต และ iCloud",
        href: "/รับซื้อ-iphone-โคราช",
      },
      {
        title: "โน๊ตบุ๊ค",
        description: "ตรวจสเปก สภาพ และอาการเสีย",
        href: "/รับซื้อโน๊ตบุ๊ค-โคราช",
      },
    ]}
  />

  <WhatToPrepare />
  <SellingProcess />

  <ProductTypeGrid
    items={[
      { title: "โทรศัพท์มือถือ", description: "iPhone Android Samsung และอื่น ๆ", href: "/รับซื้อโทรศัพท์มือถือ-โคราช" },
      { title: "คอมพิวเตอร์", description: "ตั้งโต๊ะ ประกอบ เกมมิ่ง เวิร์กสเตชัน", href: "/รับซื้อคอมพิวเตอร์-โคราช" },
      { title: "การ์ดจอ", description: "GPU มือสองส่งสเปกและรูปพัดลม", href: "/รับซื้อการ์ดจอ-โคราช" },
      { title: "กล้อง", description: "กล้องและเลนส์พร้อม shutter count", href: "/รับซื้อกล้อง-โคราช" },
      { title: "เครื่องเกม", description: "PlayStation Nintendo และอุปกรณ์เกม", href: "/รับซื้อเครื่องเกม-โคราช" },
      { title: "อุปกรณ์สำนักงาน", description: "ปริ้นเตอร์ POS และคอมบริษัท", href: "/รับซื้ออุปกรณ์สำนักงาน" },
      { title: "โน๊ตบุ๊คเสีย / จอแตก", description: "สอบถามตามสภาพได้", href: "/รับซื้อโน๊ตบุ๊คเสีย-โคราช" },
      { title: "สินค้าไม่ได้ใช้งาน", description: "เครื่องค้างสต็อกหรือไม่ได้ใช้มานาน", href: "/รับซื้อสินค้าไอทีไม่ได้ใช้งาน-โคราช" },
    ]}
  />

  <section class="section">
    <div class="container">
      <h2 class="section__title">เหมาะกับลูกค้าทั่วไป</h2>
      <p class="section__lead">
        ผู้ที่อยากขายเครื่องเดียวหรือสองสามชิ้น สามารถเริ่มจาก LINE ได้ทันที
        ไม่จำเป็นต้องจัดทำรายการยาวแบบองค์กร
      </p>
      <div class="card-grid card-grid--3">
        <article class="card">
          <h3 class="card__title">นักเรียน นักศึกษา</h3>
          <p class="card__text">โน๊ตบุ๊ค แท็บเล็ต โทรศัพท์ที่ใช้จบเทอมหรืออัปเกรด</p>
        </article>
        <article class="card">
          <h3 class="card__title">พนักงานออฟฟิศ</h3>
          <p class="card__text">เครื่องเก่าที่ไม่ได้ใช้ อุปกรณ์เสริม และจอมอนิเตอร์</p>
        </article>
        <article class="card">
          <h3 class="card__title">ผู้ประกอบการรายย่อย</h3>
          <p class="card__text">POS ปริ้นเตอร์ หรือเครื่องสำรองที่ต้องการขายออก</p>
        </article>
      </div>
    </div>
  </section>

  <BusinessBulkSection />
  <ValuationFactors />
  <ServiceAreaGrid items={areas} />

  <section class="section">
    <div class="container">
      <h2 class="section__title">การดูแลข้อมูลส่วนตัวก่อนขาย</h2>
      <p class="section__lead">
        ควรสำรองข้อมูล สำคัญ ออกจาก iCloud หรือบัญชี Google และลบข้อมูลส่วนตัวก่อนส่งมอบ
      </p>
      <div class="cta-row">
        <a class="btn btn--ghost" href="/บทความ/วิธีลบข้อมูลก่อนขายคอมพิวเตอร์">วิธีลบข้อมูลคอมพิวเตอร์</a>
        <a class="btn btn--ghost" href="/บทความ/วิธีออกจาก-icloud-ก่อนขาย-iphone-หรือ-ipad">ออกจาก iCloud</a>
        <a class="btn btn--ghost" href="/คำถามที่พบบ่อย">คำถามที่พบบ่อย</a>
      </div>
    </div>
  </section>

  <SafetyNotice />
  <RelatedArticles items={articles} />

  <section class="section section--tight service-directory-section">
    <div class="container">
      <details class="service-directory">
        <summary>
          <span><strong>บริการและหน้าข้อมูลเพิ่มเติม</strong><small>เปิดดูหมวดเฉพาะ อุปกรณ์ และพื้นที่ที่เกี่ยวข้อง</small></span>
          <span class="service-directory__icon" aria-hidden="true">+</span>
        </summary>
        <ul class="service-directory__links">
          {
            [
              ["/รับซื้อ-apple-watch-โคราช", "Apple Watch"], ["/รับซื้อ-cpu-โคราช", "CPU"],
              ["/รับซื้อ-ssd-hdd-โคราช", "SSD / HDD"], ["/รับซื้อเมนบอร์ด-โคราช", "เมนบอร์ด"],
              ["/รับซื้อแรม-โคราช", "แรม"], ["/รับซื้อจอมอนิเตอร์-โคราช", "จอมอนิเตอร์"],
              ["/รับซื้ออุปกรณ์คอมพิวเตอร์-โคราช", "อุปกรณ์คอมพิวเตอร์"], ["/รับซื้อเลนส์กล้อง-โคราช", "เลนส์กล้อง"],
              ["/รับซื้อ-playstation-โคราช", "PlayStation"], ["/รับซื้อ-nintendo-switch-โคราช", "Nintendo Switch"],
              ["/รับซื้อลำโพง-โคราช", "ลำโพง"], ["/รับซื้อหูฟัง-โคราช", "หูฟัง"],
              ["/รับซื้อ-server-network-โคราช", "Server / Network"], ["/รับซื้อเครื่องปริ้น-โคราช", "เครื่องปริ้น"],
              ["/รับซื้ออุปกรณ์-pos-โคราช", "อุปกรณ์ POS"], ["/รับซื้อคอมบริษัท-โคราช", "คอมบริษัท"],
              ["/รับซื้อคอมเกมมิ่ง-โคราช", "คอมเกมมิ่ง"], ["/รับซื้อคอมประกอบ-โคราช", "คอมประกอบ"],
              ["/รับซื้อโน๊ตบุ๊คเกมมิ่ง-โคราช", "โน๊ตบุ๊คเกมมิ่ง"], ["/รับซื้อโน๊ตบุ๊คเสีย-โคราช", "โน๊ตบุ๊คเสีย"],
              ["/รับซื้อโน๊ตบุ๊คเปิดไม่ติด-โคราช", "โน๊ตบุ๊คเปิดไม่ติด"], ["/รับซื้อโน๊ตบุ๊คจอแตก-โคราช", "โน๊ตบุ๊คจอแตก"],
              ["/รับซื้อคอมเก่า-โคราช", "คอมเก่า"], ["/รับซื้อสินค้าไอทีไม่มีอุปกรณ์-โคราช", "ไม่มีอุปกรณ์"],
              ["/ขายคอมหลายเครื่อง-โคราช", "ขายคอมหลายเครื่อง"], ["/ขายอุปกรณ์ไอทียกสำนักงาน-โคราช", "ยกสำนักงาน"],
              ["/บริษัทปิดกิจการขายอุปกรณ์ไอที", "ปิดกิจการ"], ["/วิธีประเมินราคา", "วิธีประเมินราคา"],
              ["/พื้นที่/สีคิ้ว", "สีคิ้ว"], ["/พื้นที่/สูงเนิน", "สูงเนิน"], ["/พื้นที่/พิมาย", "พิมาย"],
              ["/พื้นที่/มหาวิทยาลัยเทคโนโลยีสุรนารี", "มทส."],
            ].map(([href,label]) => <li><a href={href}>{label}<span aria-hidden="true">→</span></a></li>)
          }
        </ul>
      </details>
    </div>
  </section>

  <FAQSection items={faqs} />

  <ImageCTASection
    image={HOME_PAGE_VISUALS.cta.image}
    alt={HOME_PAGE_VISUALS.cta.alt}
    slotId={HOME_PAGE_VISUALS.cta.slotId}
    title="เห็นปุ่ม LINE ชัดขึ้น พร้อมเริ่มประเมินได้ทันที"
    description="ส่งรุ่น สเปก รูปสภาพ และตำหนิผ่าน LINE ได้เลย เพื่อรับการประเมินเบื้องต้นก่อนนัดรับหรือจัดส่ง โดยไม่ต้องลงประกาศเอง"
    note={`${SITE.priceDisclaimer} · ตรวจสอบข้อมูลร้านเพิ่มเติมได้ที่หน้าเกี่ยวกับเรา`}
    phoneCta="home_final_phone"
  />
</BaseLayout>

<style>
  .service-directory-section { padding-top:1rem; }
  .service-directory { overflow:hidden; border:1px solid var(--color-border); border-radius:var(--radius-lg); background:white; box-shadow:var(--shadow-xs); }
  .service-directory summary { min-height:64px; padding:.9rem 1rem; display:flex; align-items:center; justify-content:space-between; gap:1rem; cursor:pointer; list-style:none; }
  .service-directory summary::-webkit-details-marker { display:none; }
  .service-directory summary > span:first-child { display:flex; flex-direction:column; }
  .service-directory summary strong { color:var(--color-navy); font-size:.95rem; }
  .service-directory summary small { margin-top:.12rem; color:var(--color-text-muted); font-size:.75rem; }
  .service-directory__icon { width:2rem; height:2rem; flex:0 0 2rem; display:grid; place-items:center; border-radius:.6rem; background:#f1f5f9; font-weight:800; transition:transform .15s ease; }
  .service-directory[open] .service-directory__icon { transform:rotate(45deg); background:var(--color-primary-soft); color:var(--color-primary-dark); }
  .service-directory__links { list-style:none; margin:0; padding:0 1rem 1rem; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.35rem .7rem; }
  .service-directory__links a { min-height:38px; display:flex; align-items:center; justify-content:space-between; gap:.6rem; padding:.35rem .55rem; border-radius:.6rem; background:#f8fafc; color:var(--color-text); text-decoration:none; font-size:.78rem; font-weight:650; }
  .service-directory__links a:hover { background:#fff7ed; color:var(--color-primary-dark); }
  .service-directory__links a span { color:var(--color-primary); }
  @media(min-width:720px){ .service-directory__links { grid-template-columns:repeat(4,minmax(0,1fr)); } }
</style>
