---
import TrustPageLayout from "../layouts/TrustPageLayout.astro";
import PrimaryLineCTA from "../components/PrimaryLineCTA.astro";
import FacebookCTA from "../components/FacebookCTA.astro";
import ValuationFoundation from "../components/ValuationFoundation.astro";
import { absoluteUrl } from "../utils/seo";
import { buildGraph, webpageSchema, breadcrumbSchema } from "../utils/schema";
import { CONTACT_CHANNELS, SERVICE_AREA, SITE, STORE_LOCATION } from "../data/site";

const breadcrumbs = [
  { name: "หน้าแรก", href: "/" },
  { name: "ติดต่อ", href: "/ติดต่อ" },
];
const url = absoluteUrl("/ติดต่อ");
const description =
  "ติดต่อร้านอำพล เทรดดิ้ง (WINNER IT) เพื่อประเมินสินค้าไอที หน้าร้านจริงจังหวัดอุบลราชธานี บริการลูกค้าในนครราชสีมาผ่าน LINE และโทรศัพท์";
const schema = buildGraph([
  webpageSchema({
    type: "ContactPage",
    url,
    name: "ติดต่อร้านอำพล เทรดดิ้ง (WINNER IT)",
    description,
    dateModified: "2026-08-05",
  }),
  breadcrumbSchema(breadcrumbs),
]);
---

<TrustPageLayout
  title="ติดต่อเรา | ร้านอำพล เทรดดิ้ง · WINNER IT"
  description={description}
  h1="ติดต่อร้านอำพล เทรดดิ้ง"
  breadcrumbs={breadcrumbs}
  canonical="/ติดต่อ"
  schema={schema}
  updatedDate={new Date("2026-08-05")}
>
  <h2>หน้าร้านจริง</h2>
  <p>
    <strong>{STORE_LOCATION.tradeName}</strong> ({SITE.brand}) · {SITE.legalName}
  </p>
  <p>
    จังหวัด<strong>{STORE_LOCATION.province}</strong>
    {
      STORE_LOCATION.streetAddress ? (
        <>
          <br />
          ที่อยู่: {STORE_LOCATION.streetAddress}
          {STORE_LOCATION.postalCode ? ` ${STORE_LOCATION.postalCode}` : ""}
        </>
      ) : (
        <>
          <br />
          <span class="muted">เลขที่บ้านและแผนที่ละเอียด: รอข้อมูลที่ยืนยันแล้วก่อนเผยแพร่</span>
        </>
      )
    }
  </p>
  {
    STORE_LOCATION.openingHoursText ? (
      <p>เวลาเปิดทำการ: {STORE_LOCATION.openingHoursText}</p>
    ) : (
      <p class="muted">เวลาเปิดทำการ: รอข้อมูลที่ยืนยันแล้วก่อนเผยแพร่</p>
    )
  }
  {
    CONTACT_CHANNELS.mapsUrl && (
      <p>
        <a
          class="btn btn--ghost"
          href={CONTACT_CHANNELS.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-event="maps_click"
          data-cta="maps"
        >
          เปิด Google Maps
        </a>
      </p>
    )
  }

  <h2>ช่องทางติดต่อ</h2>
  <ul>
    <li>
      โทรศัพท์:
      <a href={`tel:${SITE.phoneTel}`} data-event="phone_click" data-cta="phone">{SITE.phoneDisplay}</a>
    </li>
    <li>
      LINE Official:
      <a href={SITE.lineUrl} target="_blank" rel="noopener noreferrer" data-event="line_click" data-cta="line">
        {SITE.lineId}
      </a>
    </li>
    {
      CONTACT_CHANNELS.facebookUrl ? (
        <li>
          Facebook:
          <a
            href={CONTACT_CHANNELS.facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-event="facebook_click"
            data-cta="facebook"
          >
            เปิดเพจ Facebook
          </a>
        </li>
      ) : (
        <li class="muted">Facebook: รอ URL เพจที่ยืนยันแล้วก่อนแสดงปุ่ม</li>
      )
    }
    {
      CONTACT_CHANNELS.mapsUrl ? (
        <li>
          Google Maps:
          <a
            href={CONTACT_CHANNELS.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-event="maps_click"
            data-cta="maps"
          >
            เปิดแผนที่
          </a>
        </li>
      ) : (
        <li class="muted">Google Maps: รอ URL ที่ยืนยันแล้วก่อนแสดง</li>
      )
    }
  </ul>

  <div class="cta-row">
    <PrimaryLineCTA label="แอด LINE @buyhub" event="line_click" />
    <a class="btn btn--phone" href={`tel:${SITE.phoneTel}`} data-event="phone_click" data-cta="phone">
      โทร {SITE.phoneDisplay}
    </a>
    <FacebookCTA />
  </div>

  <h2>ลูกค้าในจังหวัดนครราชสีมา</h2>
  <p>{SERVICE_AREA.wording}</p>
  <p>
    สามารถส่งรายละเอียดและรูปสินค้าเพื่อประเมินราคาเบื้องต้น
    และสอบถามการนัดรับหรือวิธีจัดส่งตามเงื่อนไขจริงในแต่ละครั้ง
    โปรดอย่าเข้าใจว่ามีหน้าร้านหรือสาขาประจำในจังหวัดนครราชสีมา
  </p>
  <p>พื้นที่ให้บริการ: {SERVICE_AREA.label}</p>

  <ValuationFoundation />

  <p class="disclaimer">{SITE.priceDisclaimer}</p>
  <p>
    อ่านเพิ่มเติมเกี่ยวกับร้านได้ที่หน้า <a href="/เกี่ยวกับเรา">เกี่ยวกับเรา</a>
  </p>
</TrustPageLayout>

<style>
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-4) 0 var(--space-6);
  }
  .muted {
    color: var(--color-text-muted);
  }
</style>
