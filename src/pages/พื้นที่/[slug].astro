---
import { getCollection, render } from "astro:content";
import AreaPageLayout from "../../layouts/AreaPageLayout.astro";
import { absoluteUrl } from "../../utils/seo";
import { getAllContentIndex, resolveRelated } from "../../utils/content";
import {
  breadcrumbSchema,
  buildGraph,
  faqSchema,
  serviceSchema,
  webpageSchema,
} from "../../utils/schema";

export async function getStaticPaths() {
  const areas = await getCollection("areas");
  return areas.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const index = await getAllContentIndex();
const related = resolveRelated(index, entry.data.relatedPages);
const relatedServices = related.filter((item) => !item.href.startsWith("/บทความ/"));
const relatedArticles = related.filter((item) => item.href.startsWith("/บทความ/"));
const path = `/พื้นที่/${entry.data.slug}`;
const url = absoluteUrl(path);
const breadcrumbs = [
  { name: "หน้าแรก", href: "/" },
  { name: "พื้นที่บริการ", href: "/พื้นที่/เมืองนครราชสีมา" },
  { name: entry.data.areaName, href: path },
];

const schema = buildGraph([
  webpageSchema({
    url,
    name: entry.data.title,
    description: entry.data.description,
    dateModified: entry.data.updatedDate.toISOString(),
  }),
  serviceSchema({
    url,
    name: entry.data.h1,
    description: entry.data.description,
  }),
  breadcrumbSchema(breadcrumbs),
  ...(entry.data.faq.length ? [faqSchema(entry.data.faq, url)] : []),
]);
---

<AreaPageLayout
  title={entry.data.title}
  description={entry.data.description}
  h1={entry.data.h1}
  lead={entry.data.excerpt}
  breadcrumbs={breadcrumbs}
  canonical={path}
  ogImage={entry.data.ogImage}
  updatedDate={entry.data.updatedDate}
  schema={schema}
  faqs={entry.data.faq}
  relatedServices={relatedServices}
  relatedArticles={relatedArticles}
>
  <Content />
</AreaPageLayout>
