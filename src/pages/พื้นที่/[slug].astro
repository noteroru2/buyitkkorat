---
import { getCollection, render } from "astro:content";
import AreaPageLayout from "../../layouts/AreaPageLayout.astro";
import { absoluteUrl } from "../../utils/seo";
import { getAllContentIndex, resolveRelated } from "../../utils/content";
import { breadcrumbSchema, buildGraph, faqSchema, serviceSchema, webpageSchema } from "../../utils/schema";
import { getAreaPageVisuals } from "../../data/pageVisuals";
import { getRuntimeBreadcrumbs, getRuntimeDiscoveryLinks, getRuntimeRelatedLinks } from "../../config/runtime-architecture";

const K1_AREA_SEO_OVERRIDES = {
  "ปักธงชัย": {
    title: "รับซื้อไอที ปักธงชัย โคราช | โน๊ตบุ๊ค กล้อง คอมพิวเตอร์",
    description: "รับซื้อไอทีในปักธงชัย โคราช ทั้งโน๊ตบุ๊ค กล้อง iPhone คอมพิวเตอร์และอุปกรณ์สำนักงาน ส่งรูปเพื่อประเมินเบื้องต้น นัดรับตามคิวหรือจัดส่งได้",
  },
  "ด่านขุนทด": {
    title: "รับซื้อไอที ด่านขุนทด โคราช | โน๊ตบุ๊ค มือถือ คอมพิวเตอร์",
    description: "ขายโน๊ตบุ๊ค iPhone คอมพิวเตอร์หรือแท็บเล็ตในด่านขุนทด ส่งรูป รุ่นและสภาพเพื่อประเมินเบื้องต้น นัดรับตามคิวและระยะทางหรือจัดส่งได้",
  },
  "โชคชัย": {
    title: "รับซื้อไอที โชคชัย โคราช | คอม โน๊ตบุ๊ค มือถือ",
    description: "รับซื้อไอทีในโชคชัย โคราช ทั้งคอมพิวเตอร์ โน๊ตบุ๊ค มือถือ แท็บเล็ต จอและเครื่องพิมพ์ ส่งรุ่น รูปสภาพและจำนวนเพื่อประเมินเบื้องต้น",
  },
  "มหาวิทยาลัยเทคโนโลยีสุรนารี": {
    title: "รับซื้อไอทีใกล้ มทส. โคราช | โน๊ตบุ๊ค iPhone iPad",
    description: "นักศึกษา บุคลากรและผู้พักอาศัยใกล้ มทส. ขายโน๊ตบุ๊ค iPhone iPad คอมพิวเตอร์และอุปกรณ์ไอทีได้ ส่งรูปและสเปกเพื่อประเมินเบื้องต้น",
  },
  "สีคิ้ว": {
    title: "รับซื้อไอที สีคิ้ว โคราช | คอม โน๊ตบุ๊ค อุปกรณ์สำนักงาน",
    description: "รับซื้อไอทีในสีคิ้ว โคราช ทั้งคอมพิวเตอร์ โน๊ตบุ๊ค จอ เครื่องพิมพ์และอุปกรณ์สำนักงาน รวมหลายชิ้นได้ ส่งรายการเพื่อประเมินเบื้องต้น",
  },
} as const;

export async function getStaticPaths() {
  const areas = await getCollection("areas");
  return areas.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const index = await getAllContentIndex();
const path = `/พื้นที่/${entry.data.slug}`;
const k1Seo = K1_AREA_SEO_OVERRIDES[entry.data.slug as keyof typeof K1_AREA_SEO_OVERRIDES];
const pageTitle = k1Seo?.title ?? entry.data.title;
const pageDescription = k1Seo?.description ?? entry.data.description;
const architectureRelated = [
  ...getRuntimeDiscoveryLinks(path, 16),
  ...getRuntimeRelatedLinks(path, 6),
].map((item) => item.url);
const relatedPaths = [...new Set([...architectureRelated, ...entry.data.relatedPages])];
const related = resolveRelated(index, relatedPaths);
const relatedServices = related.filter((item) => !item.href.startsWith("/บทความ/"));
const relatedArticles = related.filter((item) => item.href.startsWith("/บทความ/"));
const pageVisuals = getAreaPageVisuals();
const url = absoluteUrl(path);
const runtimeBreadcrumbs = getRuntimeBreadcrumbs(path);
const breadcrumbs = runtimeBreadcrumbs.length
  ? runtimeBreadcrumbs.map((item) => ({ name: item.reason === "HOME" ? "หน้าแรก" : item.label, href: item.url }))
  : [
      { name: "หน้าแรก", href: "/" },
      { name: "พื้นที่บริการ", href: "/พื้นที่" },
      { name: entry.data.areaName, href: path },
    ];

const schema = buildGraph([
  webpageSchema({ url, name: pageTitle, description: pageDescription, dateModified: entry.data.updatedDate.toISOString() }),
  serviceSchema({ url, name: entry.data.h1, description: pageDescription }),
  breadcrumbSchema(breadcrumbs),
  ...(entry.data.faq.length ? [faqSchema(entry.data.faq, url)] : []),
]);
---

<AreaPageLayout
  title={pageTitle}
  description={pageDescription}
  h1={entry.data.h1}
  lead={entry.data.excerpt}
  breadcrumbs={breadcrumbs}
  canonical={entry.data.canonical ?? path}
  ogImage={entry.data.ogImage}
  updatedDate={entry.data.updatedDate}
  schema={schema}
  faqs={entry.data.faq}
  relatedServices={relatedServices}
  relatedArticles={relatedArticles}
  coverVisual={pageVisuals.cover}
  ctaVisual={pageVisuals.cta}
>
  <Content />
</AreaPageLayout>